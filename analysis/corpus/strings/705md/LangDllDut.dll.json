    "text": "Houd ingedrukt om te sluiten.BSpraakherkenning wordt niet ondersteund"
  },
  {
    "file_offset": "0x531a",
    "va": "0x1000931a",
    "encoding": "utf16le",
    "text": "op dit Bluetooth-apparaat?Spraakherkenning is niet ingeschakeld op dit Bluetooth-apparaat"
  },
  {
    "file_offset": "0x53ce",
    "va": "0x100093ce",
    "encoding": "utf16le",
    "text": "Schermknoppen:"
