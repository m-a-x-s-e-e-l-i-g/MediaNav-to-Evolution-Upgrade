  },
  {
    "file_offset": "0x5002",
    "va": "0x10009002",
    "encoding": "utf16le",
    "text": "Tanggapan visual tidak akan didukung."
  },
  {
    "file_offset": "0x504e",
    "va": "0x1000904e",
    "encoding": "utf16le",
    "text": "Cakupan:"
