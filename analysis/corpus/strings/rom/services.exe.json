  {
    "file_offset": "0x2a8a",
    "va": "0x1608a",
    "encoding": "utf16le",
    "text": "\"Commands:"
  },
  {
    "file_offset": "0x2aa2",
    "va": "0x160a2",
    "encoding": "utf16le",
    "text": "help - print this text"
  },
  {
    "file_offset": "0x2ad4",
    "va": "0x160d4",
    "encoding": "utf16le",
    "text": "list - lists loaded services"
  },
  {
    "file_offset": "0x2b10",
    "va": "0x16110",
    "encoding": "utf16le",
    "text": "load <service name> - activates a service that is inactive"
  },
  {
    "file_offset": "0x2b8a",
    "va": "0x1618a",
    "encoding": "utf16le",
    "text": "stop <service instance> stops/pauses a service (does not unload)"
  },
  {
    "file_offset": "0x2c10",
    "va": "0x16210",
    "encoding": "utf16le",
    "text": "start <service instance> - starts/resumes a service"
  },
  {
    "file_offset": "0x2c7c",
    "va": "0x1627c",
    "encoding": "utf16le",
    "text": "refresh <service instance> - causes service to refresh its config"
  },
  {
    "file_offset": "0x2d04",
    "va": "0x16304",
    "encoding": "utf16le",
    "text": "unload <service instance> - causes service to be unloaded and removed"
  },
  {
    "file_offset": "0x2d94",
    "va": "0x16394",
    "encoding": "utf16le",
    "text": "register <service name> - service will be automatically loaded on next reboot"
  },
  {
    "file_offset": "0x2e34",
    "va": "0x16434",
    "encoding": "utf16le",
    "text": "unregister <service name> - service will not be automatically loaded on next reboot"
  },
  {
    "file_offset": "0x2edc",
    "va": "0x164dc",
    "encoding": "utf16le",
    "text": "7Usage:"
  },
